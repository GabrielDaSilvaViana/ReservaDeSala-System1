# ─────────────────────────────────────────────────────────────────────────────
#  InnovaRoom — configurações (copie para ".env" e ajuste)
#  O .env NÃO vai para o GitHub (está no .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# Servidor web
PORT=3000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=innovaroom

# Senha do usuário "admin" criada na PRIMEIRA vez que o servidor inicia.
# Depois disso, troque a senha pelo painel do administrador.
ADMIN_SENHA=admin123

# Regras de reserva
RESERVA_MIN_MINUTOS=5
OCUPACAO_ANTECEDENCIA_MIN=30

# Solenoide / ESP32
#   auto      = usa o ESP32 se ESP32_HOST estiver preenchido (padrão)
#   hardware  = ao ocupar a sala o servidor manda o ESP32 destravar
#   simulacao = só a animação na tela
SOLENOIDE_MODO=auto
# Prazo (ms) para tirar a chave depois de destravar
SOLENOIDE_DURACAO_MS=10000
ESP32_HOST=
ESP32_PORT=80
# Mesmo valor de ESP32_TOKEN no esp32/solenoid_arduino/secrets.h
ESP32_TOKEN=
ESP32_TIMEOUT_MS=5000

# Devolução da chave: texto do QR code preso nas chaves de cada solenoide
# (imagens prontas para imprimir em docs/qrcodes/).
QRCODE_SOLENOIDE_1=INNOVAROOM-SOLENOIDE-1
QRCODE_SOLENOIDE_2=INNOVAROOM-SOLENOIDE-2
QRCODE_SOLENOIDE_3=INNOVAROOM-SOLENOIDE-3
# Solenoide usada pelas salas sem solenoide definida (ex.: 2º andar)
SOLENOIDE_PADRAO=1
# Prazo (ms) para colocar a chave depois de ler o QR code
DEVOLUCAO_TEMPO_MS=20000

# Token que o leitor de digital da porta (ESP32 + DY50) envia em /api/porta/digital
DISPOSITIVO_TOKEN=
